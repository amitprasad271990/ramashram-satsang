# Copy this file to .env.local and fill in the values.
# .env.local is never committed to git.
#
# LOCAL MODE (now): Supabase runs in Docker on this Mac (`npm run db:start`),
# media files are served from .media/. The local keys are printed by
# `npx supabase status`; they are well-known development keys, not secrets.
#
# GOING LIVE (later): replace the Supabase values with the cloud project's,
# set MEDIA_STORAGE=r2 and fill in the R2 values.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Admin ---
ADMIN_EMAIL=admin@example.com   # the one admin login (real value only in .env.local)

# --- Media: "local" (this Mac) or "r2" (Cloudflare, for going live) ---
MEDIA_STORAGE=local
# Leave empty in local mode. For R2: the bucket's public address.
NEXT_PUBLIC_MEDIA_BASE_URL=

# --- Cloudflare R2 (only when MEDIA_STORAGE=r2) ---
R2_ACCOUNT_ID=
R2_BUCKET=ramashram-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Amazon S3 instead of R2: set the bucket's region (and leave R2_ACCOUNT_ID empty).
S3_REGION=
# Any other S3-compatible service: its endpoint address.
S3_ENDPOINT=
