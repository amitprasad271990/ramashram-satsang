# Copy this file to .env.local and fill in the values.
# .env.local is never committed to git.
#
# LOCAL MODE (now): Supabase runs in Docker on this Mac (`npm run db:start`),
# media files are served from .media/. The local keys are printed by
# `npx supabase status`; they are well-known development keys, not secrets.
#
# GOING LIVE (later): replace the Supabase values with the cloud project's,
# set MEDIA_STORAGE=r2 and fill in the R2 values.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Admin ---
ADMIN_EMAIL=admin@example.com   # the one admin login (real value only in .env.local)

# --- Media: "local" (this Mac) or "s3" (Amazon S3 + CloudFront, when live) ---
MEDIA_STORAGE=local
# Leave empty in local mode. Live: the CloudFront address of the media bucket.
NEXT_PUBLIC_MEDIA_BASE_URL=

# --- Amazon S3 (only when MEDIA_STORAGE=s3) ---
S3_BUCKET=ramashram-satsang-media-mumbai
S3_REGION=ap-south-1
# No keys needed: this Mac uses `aws login`, Amplify uses the website's IAM role.
