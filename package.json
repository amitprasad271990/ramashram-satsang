{
  "name": "ramashram-satsang",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "extract": "node scripts/image-sizes.mjs && node scripts/extract-content.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "media": "node scripts/prepare-media.mjs",
    "db:seed": "node --env-file=.env.local scripts/db-seed.mjs",
    "media:upload": "node --env-file=.env.local scripts/media-upload.mjs",
    "verify": "node --env-file=.env.local scripts/verify-migration.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && npm run db:seed",
    "admin:password": "node --env-file=.env.local scripts/admin-password.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "html-react-parser": "^5.2.6",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.1.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^12.3.2",
    "pg": "^8.23.1",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true,
    "supabase@2.122.0": true
  }
}
